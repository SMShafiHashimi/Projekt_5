<Window x:Class="RechnungsGenerator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kundenprojekt: Rechnungs- und Angebotsgenerator" Height="700" Width="1050"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" BorderBrush="LightGray" BorderThickness="0,0,1,0" Padding="0,0,10,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="140"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Kundenverwaltung" FontSize="16" FontWeight="Bold" Margin="0,0,0,5"/>

                <ListBox Grid.Row="1" x:Name="lstKunden" Margin="0,0,0,10" SelectionChanged="lstKunden_SelectionChanged"/>

                <StackPanel Grid.Row="2" Margin="0,0,0,15">
                    <TextBlock Text="Kunde anlegen / bearbeiten" FontWeight="Bold" Margin="0,0,0,5"/>

                    <TextBlock Text="Kunden-Nr:"/>
                    <TextBox x:Name="txtKundenNummer" Margin="0,2,0,5"/>

                    <TextBlock Text="Name / Firma:"/>
                    <TextBox x:Name="txtName" Margin="0,2,0,5"/>

                    <TextBlock Text="Adresse:"/>
                    <TextBox x:Name="txtAdresse" Margin="0,2,0,5"/>

                    <Button x:Name="btnNeuerKunde" Content="Als neuen Kunden speichern" Height="25" Margin="0,5,0,2" Click="btnNeuerKunde_Click"/>

                    <!-- ZUSATZFUNKTIONEN -->
                    <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" x:Name="btnKundeBearbeiten" Content="Änderung speichern" Height="25" Margin="0,0,2,0" Click="btnKundeBearbeiten_Click"/>
                        <Button Grid.Column="1" x:Name="btnKundeLoeschen" Content="Kunde löschen" Background="MistyRose" Height="25" Margin="2,0,0,0" Click="btnKundeLoeschen_Click"/>
                    </Grid>
                    <!-- Ende der ZUSATZFUNKTION-->
                    
                </StackPanel>

                <TextBlock Grid.Row="3" Text="Erstellte Dokumente des Kunden:" FontWeight="Bold" Margin="0,5,0,5"/>
                <ListBox Grid.Row="4" x:Name="lstErstellteDokumente"/>
            </Grid>
        </Border>

       <Grid Grid.Column="1" Margin="15,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                <TextBlock Text="Dokumententyp auswählen:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,15,0"/>
                <RadioButton Content="Angebot" IsChecked="True" x:Name="rbAngebot" VerticalAlignment="Center" Margin="0,0,15,0" Checked="DokumentTyp_Changed"/>
                <RadioButton Content="Rechnung" x:Name="rbRechnung" VerticalAlignment="Center" Checked="DokumentTyp_Changed"/>
            </StackPanel>

            <DataGrid Grid.Row="1" x:Name="dgPositionen" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" CellEditEnding="dgPositionen_CellEditEnding">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Bezeichnung" Width="*" Binding="{Binding Bezeichnung, UpdateSourceTrigger=PropertyChanged}"/>
                    <DataGridTextColumn Header="Menge" Width="80" Binding="{Binding Menge, UpdateSourceTrigger=PropertyChanged}"/>
                    <DataGridTextColumn Header="Einzelpreis (€)" Width="100" Binding="{Binding Einzelpreis, StringFormat={}{0:N2} €, UpdateSourceTrigger=PropertyChanged}"/>
                    <DataGridTextColumn Header="Gesamtpreis (€)" Width="120" Binding="{Binding Gesamtpreis, StringFormat={}{0:N2} €}" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>

            <Button Grid.Row="2" x:Name="btnPositionHinzufuegen" Content="+ Position hinzufügen" HorizontalAlignment="Left" Width="160" Height="30" Margin="0,10,0,10" Click="btnPositionHinzufuegen_Click"/>

            <Border Grid.Row="3" BorderBrush="LightGray" BorderThickness="0,1,0,0" Padding="0,15,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <TextBlock Text="Rabatt (%):" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox x:Name="txtRabatt" Width="50" Height="25" VerticalAlignment="Center" Text="0" TextChanged="txtRabatt_TextChanged"/>
                        <Button x:Name="btnDokumentErstellen" Content="Dokument erstellen" Width="150" Height="35" FontWeight="Bold" Margin="20,0,0,0" Click="btnDokumentErstellen_Click"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" Margin="0,0,15,0">
                        <TextBlock Text="Zwischensumme:" Margin="0,2"/>
                        <TextBlock Text="Rabatt:" Margin="0,2"/>
                        <TextBlock Text="Mehrwertsteuer (19%):" Margin="0,2"/>
                        <TextBlock Text="Endbetrag:" FontSize="16" FontWeight="Bold" Margin="0,5,0,2"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                        <TextBlock x:Name="lblZwischensumme" Text="0,00 €" Margin="0,2"/>
                        <TextBlock x:Name="lblRabatt" Text="0,00 €" Margin="0,2"/>
                        <TextBlock x:Name="lblMwSt" Text="0,00 €" Margin="0,2"/>
                        <TextBlock x:Name="lblEndbetrag" Text="0,00 €" FontSize="16" FontWeight="Bold" Foreground="DarkGreen" Margin="0,5,0,2"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>